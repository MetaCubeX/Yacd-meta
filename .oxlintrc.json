{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y"],
  // 不整类开启：oxlint 升级会往 correctness 里加规则，这里只列能抓到 tsc（strict）抓不到的 bug 的规则。
  // tsc 已覆盖的（no-const-assign、no-dupe-keys、getter-return 等）不列；
  // type-aware 规则（no-floating-promises 等）要装 oxlint-tsgolint 并加 --type-aware 才会执行，也不列
  "categories": {
    "correctness": "off"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "globals": {
    "__DEV__": "readonly",
    "__VERSION__": "readonly"
  },
  "ignorePatterns": ["public", "dist", "node_modules", "bin", "assets"],
  "rules": {
    "for-direction": "error",
    "no-async-promise-executor": "error",
    "no-compare-neg-zero": "error",
    "no-cond-assign": "error",
    "no-constant-binary-expression": "error",
    "no-constant-condition": "error",
    "no-control-regex": "error",
    "no-debugger": "error",
    "no-dupe-else-if": "error",
    "no-duplicate-case": "error",
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-empty-character-class": "error",
    "no-empty-pattern": "error",
    "no-ex-assign": "error",
    "no-invalid-regexp": "error",
    "no-irregular-whitespace": "error",
    "no-loss-of-precision": "error",
    "no-misleading-character-class": "error",
    "no-self-assign": "error",
    "no-sparse-arrays": "error",
    "no-unassigned-vars": "error",
    "no-unsafe-finally": "error",
    "no-unsafe-optional-chaining": "error",
    "no-useless-backreference": "error",
    "use-isnan": "error",

    "typescript/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "caughtErrors": "none" }],
    "typescript/no-unused-expressions": [
      "error",
      { "allowShortCircuit": true, "allowTernary": true }
    ],
    "typescript/no-use-before-define": ["error", { "functions": false }],
    "typescript/no-non-null-asserted-optional-chain": "error",

    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "react/jsx-key": "error",

    // 只查 ARIA 与标记本身是否写对，不查键盘交互类（click-events-have-key-events 等）
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/no-aria-hidden-on-focusable": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error"
  }
}
